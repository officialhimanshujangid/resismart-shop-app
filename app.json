{
  "expo": {
    "name": "ResiSmart Shop",
    "slug": "resismart-shop",
    "version": "1.0.0",
    "scheme": "resismart-shop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "54.0.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A4020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resismart.shop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A4020"
      },
      "package": "com.resismart.shop"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
