{
  "expo": {
    "name": "ResiSmart Shop",
    "slug": "resismart-shop",
    "version": "1.0.0",
    "scheme": "resismart-shop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "54.0.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A4020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resismart.shop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A4020"
      },
      "package": "com.resismart.shop",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan barcodes and QR codes for the catalog and billing.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ResiSmart Shop uses your location to place your shop on the map so customers nearby can find it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ResiSmart Shop needs access to your photos so you can upload your GST certificate or licence for verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a42c109-d8d8-4f37-983c-4a23c51b9724"
      }
    }
  }
}
