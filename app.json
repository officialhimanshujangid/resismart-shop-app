{
  "expo": {
    "name": "RS Partner",
    "slug": "resismart-shop",
    "version": "1.0.0",
    "scheme": "resismart-shop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "54.0.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A4020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resismart.shop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A4020",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.resismart.shop",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAQOP2i4_PezixhzKQndjHPFglUkB8bmH0"
        }
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan barcodes and QR codes for the catalog and billing.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RS Partner uses your location to place your shop on the map so customers nearby can find it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RS Partner needs access to your photos so you can add product pictures to your catalogue and upload your GST certificate or licence for verification.",
          "cameraPermission": "RS Partner uses your camera to photograph products for your catalogue.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A4020",
          "sounds": [
            "./assets/sounds/urgent.wav",
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab3e0c62-dc07-452b-b235-326221b1520b"
      }
    },
    "owner": "easy-connect-private-limited"
  }
}
